{#
  icons.njk — les petites icônes dessinées en SVG (flèches, réseaux…)
  Utilisation dans une page :
      {% from "partials/icons.njk" import icon %}
      {{ icon("arrow") }}          ← taille 16 par défaut
      {{ icon("github", 18) }}
  Les icônes officielles DAH (innovation, recherche…) sont des images PNG :
  voir partials/brand-icon.njk
#}
{% macro icon(name, size = 16) -%}
<svg class="icon icon-{{ name }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
{%- if name == "arrow" -%}<path d="M5 12h14M13 6l6 6-6 6"/>
{%- elif name == "arrow-left" -%}<path d="M19 12H5M11 6l-6 6 6 6"/>
{%- elif name == "external" -%}<path d="M14 4h6v6"/><path d="M20 4l-9 9"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/>
{%- elif name == "github" -%}<circle cx="6" cy="5.5" r="2.2"/><circle cx="6" cy="18.5" r="2.2"/><circle cx="18" cy="8" r="2.2"/><path d="M6 7.7v8.6"/><path d="M18 10.2c0 3.8-4.5 4.3-10.3 6.6"/>
{%- elif name == "linkedin" -%}<rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 10.5V16M8 7.5v.01M12 16v-3.2c0-1.4 1-2.3 2.2-2.3s2 .9 2 2.3V16M12 10.5V16"/>
{%- elif name == "whatsapp" -%}<path d="M4 12a8 8 0 1 1 3.5 6.6L4 20l1.3-3.6A7.96 7.96 0 0 1 4 12Z"/><path d="M9.2 9.3c.2 1.6 1.9 3.7 3.8 4.4l1.2-1 1.6.8c-.2.9-1 1.5-1.9 1.5-2.6-.3-5.3-2.9-5.6-5.5 0-.9.6-1.7 1.5-1.9l.8 1.6-1 1.1"/>
{%- elif name == "sun" -%}<circle cx="12" cy="12" r="4"/><path d="M12 2.5v2.2M12 19.3v2.2M4.9 4.9l1.6 1.6M17.5 17.5l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.9 19.1l1.6-1.6M17.5 6.5l1.6-1.6"/>
{%- elif name == "moon" -%}<path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"/>
{%- elif name == "menu" -%}<path d="M4 7h16M4 12h16M4 17h16"/>
{%- elif name == "close" -%}<path d="M6 6l12 12M18 6 6 18"/>
{%- elif name == "plus" -%}<path d="M12 5v14M5 12h14"/>
{%- elif name == "search" -%}<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
{%- elif name == "mail" -%}<rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M4 6.5 12 13l8-6.5"/>
{%- elif name == "pin" -%}<path d="M12 21s-6.5-5.9-6.5-11A6.5 6.5 0 0 1 18.5 10c0 5.1-6.5 11-6.5 11Z"/><circle cx="12" cy="10" r="2.3"/>
{%- elif name == "user" -%}<circle cx="12" cy="8.5" r="3.6"/><path d="M4.5 20c.9-3.8 3.9-6 7.5-6s6.6 2.2 7.5 6"/>
{%- elif name == "chevron" -%}<path d="m6 9 6 6 6-6"/>
{%- elif name == "link" -%}<path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"/><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/>
{%- elif name == "trophy" -%}<path d="M8 4h8v5a4 4 0 0 1-8 0Z"/><path d="M8 6H5a3 3 0 0 0 3 4M16 6h3a3 3 0 0 1-3 4M12 13v4M9 20h6"/>
{%- elif name == "cap" -%}<path d="m2 9 10-5 10 5-10 5Z"/><path d="M6 11v5c3 2.5 9 2.5 12 0v-5M22 9v6"/>
{%- elif name == "video" -%}<rect x="3" y="6" width="13" height="12" rx="2"/><path d="m16 10 5-3v10l-5-3"/>
{%- elif name == "flask" -%}<path d="M9 3h6M10 3v6l-5 9a2 2 0 0 0 1.8 3h10.4a2 2 0 0 0 1.8-3l-5-9V3"/><path d="M7.5 15h9"/>
{%- elif name == "star" -%}<path fill="currentColor" stroke="none" d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.5L12 17.3l-5.9 3.2 1.3-6.5-4.9-4.6 6.6-.8L12 2.5Z"/>
{%- endif -%}
</svg>
{%- endmacro %}

{# Icône officielle DAH (image PNG) dans son carré blanc #}
{% macro brandIcon(name, size = 30, badge = "") -%}
<span class="icon-badge {{ badge }}"><img class="icon-img" src="/assets/images/icons/{{ name or 'innovation' }}.png" alt="" width="{{ size }}" height="{{ size }}" loading="lazy"></span>
{%- endmacro %}

{# Motif « points de connexion » (décor) #}
{% macro net(style, lineColor, nodeA, nodeB) -%}
<svg class="net" aria-hidden="true" viewBox="0 0 600 400" style="{{ style }}; color: {{ lineColor }}"><g class="net-lines"><line x1="66" y1="86" x2="186" y2="46"/><line x1="186" y1="46" x2="306" y2="96"/><line x1="306" y1="96" x2="426" y2="56"/><line x1="426" y1="56" x2="546" y2="116"/><line x1="66" y1="86" x2="116" y2="206"/><line x1="306" y1="96" x2="246" y2="236"/><line x1="306" y1="96" x2="376" y2="196"/><line x1="546" y1="116" x2="506" y2="256"/><line x1="116" y1="206" x2="246" y2="236"/><line x1="246" y1="236" x2="376" y2="196"/><line x1="376" y1="196" x2="506" y2="256"/><line x1="116" y1="206" x2="86" y2="336"/><line x1="246" y1="236" x2="226" y2="356"/><line x1="376" y1="196" x2="356" y2="326"/><line x1="506" y1="256" x2="486" y2="366"/><line x1="86" y1="336" x2="226" y2="356"/><line x1="226" y1="356" x2="356" y2="326"/><line x1="356" y1="326" x2="486" y2="366"/></g><g class="net-nodes"><rect x="60" y="80" width="12" height="12" rx="3" fill="{{ nodeA }}"/><rect x="180" y="40" width="12" height="12" rx="3" fill="{{ nodeB }}"/><rect x="300" y="90" width="12" height="12" rx="3" fill="{{ nodeA }}"/><rect x="420" y="50" width="12" height="12" rx="3" fill="{{ nodeA }}"/><rect x="540" y="110" width="12" height="12" rx="3" fill="{{ nodeB }}"/><rect x="110" y="200" width="12" height="12" rx="3" fill="{{ nodeA }}"/><rect x="240" y="230" width="12" height="12" rx="3" fill="{{ nodeB }}"/><rect x="370" y="190" width="12" height="12" rx="3" fill="{{ nodeA }}"/><rect x="500" y="250" width="12" height="12" rx="3" fill="{{ nodeA }}"/><rect x="80" y="330" width="12" height="12" rx="3" fill="{{ nodeB }}"/><rect x="220" y="350" width="12" height="12" rx="3" fill="{{ nodeA }}"/><rect x="350" y="320" width="12" height="12" rx="3" fill="{{ nodeA }}"/><rect x="480" y="360" width="12" height="12" rx="3" fill="{{ nodeB }}"/></g></svg>
{%- endmacro %}
