{#
  activity-row.njk — une activité À VENIR (grande carte sur toute la largeur)
  Reçoit la variable `activity` (un fichier de src/content/activities/).
  À gauche l'affiche (si elle existe) et la date façon calendrier, au centre
  les infos, à droite « S'inscrire ». S'il y a un lien d'inscription, un clic
  n'importe où sur la carte l'ouvre.
#}
{% from "partials/icons.njk" import icon %}
{%- set e = activity.data -%}
{%- set link = e.register if (e.register | isLink) else "" -%}
<article class="card{% if link %} card-hover{% endif %} event-row{% if e.image %} event-row--poster{% endif %}" data-reveal>
  {%- if e.image %}
  <a class="event-poster above" href="{{ e.image }}" target="_blank" rel="noopener"><img src="{{ e.image }}" alt="{{ t.activities.poster }} : {{ e.title }}" width="160" height="160" loading="lazy"></a>
  {%- endif %}
  <div class="event-date" aria-hidden="true">
    <span class="event-date__day">{{ activity.date | readableDate(lang, "day") }}</span>
    <span class="event-date__month">{{ activity.date | readableDate(lang, "monthShort") }}</span>
  </div>
  <div class="event-body">
    <div class="event-labels">
      <span class="tag tag-accent">{{ t.activities.types[e.type] or e.type }}</span>
      {%- if e.lang %}<span class="lang-badge" title="{{ t.activities.langs[e.lang] }}"><span aria-hidden="true">{{ e.lang | upper }}</span><span class="sr-only">{{ t.activities.langs[e.lang] }}</span></span>{% endif %}
      {%- if e.draft %}<span class="draft-badge">{{ t.common.draft }}</span>{% endif %}
    </div>
    <h3 class="card-title">
      {%- if link %}<a class="stretched" href="{{ link }}" target="_blank" rel="noopener">{{ e.title }}</a>{% else %}{{ e.title }}{% endif -%}
    </h3>
    <p class="event-meta">
      <time datetime="{{ activity.date | isoDate }}"><strong>{{ activity.date | readableDate(lang, "full") }}</strong></time>
      {%- if e.time %} · {{ e.time | clock }}{% endif %}
    </p>
    {%- if e.speakers and e.speakers.length %}
    <p class="event-meta">{{ t.activities.with }} {{ e.speakers | join(", ") }}</p>
    {%- endif %}
    <p class="card-text">{{ e | tr("summary", lang) }}</p>
    {%- if e.gallery and e.gallery.length %}
    <ul class="event-gallery above">
      {%- for img in e.gallery %}
      <li><a href="{{ img }}" target="_blank" rel="noopener"><img src="{{ img }}" alt="{{ t.activities.gallery }} {{ loop.index }} : {{ e.title }}" width="72" height="72" loading="lazy"></a></li>
      {%- endfor %}
    </ul>
    {%- endif %}
  </div>
  {%- if link %}
  <a class="btn btn-primary btn-sm event-cta above" href="{{ link }}" target="_blank" rel="noopener">{{ t.activities.register }} {{ icon("arrow") }}</a>
  {%- endif %}
</article>
